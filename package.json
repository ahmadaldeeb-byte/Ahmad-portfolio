{
  "name": "heroes-world",
  "version": "1.0.0",
  "productName": "HeroesWorld",
  "description": "منصة ألعاب تعليمية عربية للصفوف الأول والثاني والثالث",
  "author": "Ahmad Aldeeb",
  "main": "desktop/main.cjs",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/build-sw.mjs out",
    "start": "node scripts/serve-static.mjs out 3000",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:standalone": "vite build -c vite.standalone.config.mts",
    "serve:web": "node scripts/serve-static.mjs out 3100",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "test:desktop": "playwright test -c playwright.desktop.config.ts",
    "audit:content": "node scripts/release/audit.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "fake-indexeddb": "^6.2.6",
    "idb": "^8.0.4",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "^16.4.3",
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
